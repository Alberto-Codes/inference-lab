FROM docker.io/vllm/vllm-openai:v0.26.0@sha256:770fe65b2c73ee74a5c42165cf3433de4048cc2cd9c57a937ca4e35aba5aa87b
# Pinned upstream reference stack; model/plugin source shares one immutable revision.
RUN python3 -m pip install 'huggingface-hub==1.24.0'
RUN python3 -c "from huggingface_hub import snapshot_download; snapshot_download('nvidia/Nemotron-3.5-Parse', revision='62cb1e4ba153d113ff64aaf2be6e068c377cf53c', local_dir='/model', allow_patterns=['*.json','*.py','*.jinja','*.txt','*.toml','LICENSE','THIRD_PARTY_NOTICES.md','TOKENIZER_ATTRIBUTION.md','*.safetensors','nemotron_parse/**','vllm_tied_patch/**'])"
RUN python3 -m pip install '/model[vllm,client]' 'vllm==0.26.0' 'torch==2.11.0' 'torchvision==0.26.0' 'transformers==5.14.1' 'huggingface-hub==1.24.0' && python3 -m pip check
RUN python3 -m pip freeze > /serving-packages.txt
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
